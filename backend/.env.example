# Salin file ini menjadi `.env` lalu sesuaikan nilainya.

# PostgreSQL — sesuai docker-compose.yml di-folder ini
DATABASE_URL=postgresql+psycopg://app:app_password@localhost:5432/transit

# JWT secret (ganti di production)
JWT_SECRET=change-me-to-a-random-32+-char-string-please
JWT_ALGORITHM=HS256
JWT_EXPIRES_MIN=720

# CORS dev
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
